{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChiiKang/ai-company-os/schemas/handoff.schema.json",
  "title": "Evidence-preserving workflow handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "assignment_id", "run_id", "created_at", "workflow", "source_role", "target_role", "automatic", "requested_by_original_assignment", "confidence", "load_bearing_claims", "evidence_refs", "provenance", "uncertainty", "approval_boundaries_triggered"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^handoff_[A-Za-z0-9_-]{8,64}$"},
    "assignment_id": {"type": "string", "pattern": "^asn_[A-Za-z0-9_-]{8,64}$"},
    "run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9_-]{8,64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "workflow": {"enum": ["research-to-idea-validation", "research-to-project-validation", "project-validation-to-builder"]},
    "source_role": {"enum": ["research", "project-validation", "idea-validation", "builder"]},
    "target_role": {"enum": ["research", "project-validation", "idea-validation", "builder"]},
    "automatic": {"type": "boolean"},
    "requested_by_original_assignment": {"type": "boolean"},
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "score", "rationale", "evidence_basis", "major_assumptions", "contradictions", "alternatives_tested", "reversal_risk"],
      "properties": {
        "level": {"enum": ["low", "medium", "high"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_basis": {"enum": ["material-evidence-missing", "indirect", "primary", "independently-reproduced", "multiple-independent", "faithful-reproduction"]},
        "major_assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "contradictions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement", "outcome_reversing", "resolved"],
            "properties": {
              "statement": {"type": "string", "minLength": 1},
              "outcome_reversing": {"type": "boolean"},
              "resolved": {"type": "boolean"}
            }
          }
        },
        "alternatives_tested": {"type": "boolean"},
        "reversal_risk": {"enum": ["likely", "unknown", "unlikely"]}
      }
    },
    "load_bearing_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "statement", "confidence", "evidence_refs", "rationale"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "confidence": {"enum": ["low", "medium", "high"]},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "origin_role", "content_sha256"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "origin_role": {"enum": ["research", "project-validation", "idea-validation", "builder"]},
          "content_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    },
    "uncertainty": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "approval_boundaries_triggered": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
