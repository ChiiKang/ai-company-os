{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChiiKang/ai-company-os/schemas/decision-report.schema.json",
  "title": "Searchable decision report metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "assignment_id", "run_id", "created_at", "role", "title", "summary", "decision", "confidence", "evidence_refs", "citations", "uncertainty", "criteria", "report_path", "tags"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^decision_[A-Za-z0-9_-]{8,64}$"},
    "assignment_id": {"type": "string", "pattern": "^asn_[A-Za-z0-9_-]{8,64}$"},
    "run_id": {"type": "string", "pattern": "^run_[A-Za-z0-9_-]{8,64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "role": {"enum": ["research", "project-validation", "idea-validation", "builder"]},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "decision": {"enum": ["research complete", "confirmed", "partially confirmed", "contradicted", "could not attempt", "could not reproduce", "works but impractical", "promising but more evidence required", "proceed", "modify", "test further", "reject", "acceptance met", "unmet criteria"]},
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "score", "rationale", "evidence_basis", "major_assumptions", "contradictions", "alternatives_tested", "reversal_risk"],
      "properties": {
        "level": {"enum": ["low", "medium", "high"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_basis": {"enum": ["material-evidence-missing", "indirect", "primary", "independently-reproduced", "multiple-independent", "faithful-reproduction"]},
        "major_assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "contradictions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement", "outcome_reversing", "resolved"],
            "properties": {
              "statement": {"type": "string", "minLength": 1},
              "outcome_reversing": {"type": "boolean"},
              "resolved": {"type": "boolean"}
            }
          }
        },
        "alternatives_tested": {"type": "boolean"},
        "reversal_risk": {"enum": ["likely", "unknown", "unlikely"]}
      }
    },
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_uri", "source_title", "publication_date", "retrieved_at", "primary_source"],
        "properties": {
          "source_uri": {"type": "string", "format": "uri"},
          "source_title": {"type": "string", "minLength": 1},
          "publication_date": {"type": "string", "format": "date"},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "primary_source": {"type": "boolean"}
        }
      }
    },
    "uncertainty": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence_refs"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "status": {"enum": ["met", "unmet", "not tested"]},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "demand_validation": {"enum": ["not applicable", "desk research only", "behavioral demand evidence"]},
    "report_path": {"const": "report.md"},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
